# Navio web client environment
#
# Copy to .env.local for local development. The values below are the LOCAL
# defaults; the comment on each line gives the production (Vercel) counterpart.
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time — never put a secret behind that prefix.

# --- Auth.js core -----------------------------------------------------------

# Signing/encryption key for the session JWT. Generate with `npx auth secret`.
# Use a DIFFERENT value in production than locally; rotating it invalidates
# every active session.
AUTH_SECRET=generate-a-random-value-with-npx-auth-secret

# Canonical origin Auth.js builds callback URLs from. On Vercel set this to the
# production domain (https://<project>.vercel.app) rather than leaving it to
# per-deployment detection, so the callback always matches the single redirect
# URI registered in Keycloak.
AUTH_URL=http://localhost:3000

# Required when running behind a proxy/CDN that terminates TLS, which includes
# Vercel. Without it Auth.js can derive an http:// callback and Keycloak will
# reject the request.
AUTH_TRUST_HOST=true

# --- Auth.js: Keycloak provider ---------------------------------------------

AUTH_KEYCLOAK_ID=navio-web

# Must equal KEYCLOAK_WEB_CLIENT_SECRET in the server-side .deploy/.env.
# navio-web is a confidential client, so this secret is held only by the
# Next.js server — it is never sent to the browser.
AUTH_KEYCLOAK_SECRET=must-match-keycloak-web-client-secret

# Realm issuer. Must match the token 'iss' claim EXACTLY, including scheme and
# with no trailing slash. Production: https://navio.sit.kmutt.ac.th/realms/navio
# The certificate at this host must be issued by a publicly trusted CA — a
# self-signed cert makes Vercel's server-side token exchange fail.
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/navio

# --- Backend ----------------------------------------------------------------

# Base URL the Next.js server-side proxies call. Server-only (no NEXT_PUBLIC_
# prefix) so the gateway address never reaches browser code.
# Production: https://navio.sit.kmutt.ac.th
NAVIO_API_BASE_URL=http://localhost:8080

# --- Maps: browser basemap --------------------------------------------------

# Maps JavaScript API key. Public by design, so restrict it in Google Cloud to
# the Maps JavaScript API and to approved HTTP referrers — which must include
# the Vercel production domain, or the map fails to load there.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloud-styled map id. Falls back to DEMO_MAP_ID when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Basemap provider: "google" (default) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=google

# Only required when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a public (pk.)
# token restricted by URL, never a secret (sk.) token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Development toggles ----------------------------------------------------

# Set to "mock" to serve places and EV chargers from local fixtures instead of
# the gateway. Leave unset in production.
NEXT_PUBLIC_PLACE_DATA_SOURCE=

# Do not configure GOOGLE_PLACES_API_KEY, GOOGLE_ROUTES_API_KEY,
# GOOGLE_MAPS_SERVER_API_KEY, or Mapbox web-service credentials here. Those are
# server-side keys owned by the Mobility & EV service; the client reaches those
# APIs only through the gateway.
